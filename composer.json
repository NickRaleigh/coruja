{
    "name": "nickraleigh/coruja",
    "description": "A small Kirby-style flat-file CMS: git-backed YAML content, a blueprint-driven admin panel, on-page SEO analysis, and an SSRF-guarded URL checker. Symfony bundle.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/cache": "^3.0",
        "symfony/dependency-injection": "8.0.*",
        "symfony/event-dispatcher": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/process": "8.0.*",
        "symfony/security-csrf": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "autoload": {
        "psr-4": {
            "Coruja\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
